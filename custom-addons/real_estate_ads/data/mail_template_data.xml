<odoo>
    <data noupdate="1">
        <record id="email_template_property_sold" model="mail.template">
            <field name="name">Property: Sold Notification</field>
            <field name="model_id" ref="real_estate_ads.model_estate_property"/>
            <field name="subject">Congratulations! Your property {{ object.name }} is Sold</field>
            <field name="email_from">{{ object.sales_id.email }}</field>
            <field name="partner_to">{{ object.buyer_id.id }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px;">
                    <p>Hello <t t-out="object.buyer_id.name"/>,</p>
                    <p>We are excited to confirm that the property <strong><t t-out="object.name"/></strong> 
                    at postcode <t t-out="object.postcode"/> has been officially marked as <strong>Sold</strong>.</p>
                    <p>Final Price: <strong><t t-out="object.selling_price"/></strong></p>
                    <p>Best regards,<br/><t t-out="object.sales_id.name"/></p>
                </div>
            </field>
        </record>
    </data>
</odoo>