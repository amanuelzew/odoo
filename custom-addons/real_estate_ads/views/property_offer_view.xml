<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_property_offer" model="ir.actions.act_window">
            <field name="name">Property</field>
            <field name="res_model">estate.property.offer</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- server action -->
        <record id="action_extend_offer_deadline" model="ir.actions.server">
            <field name="name">Extend Deadline</field>
            <field name="model_id" ref="real_estate_ads.model_estate_property_offer"/>
            <field name="state">code</field>
            <field name="binding_model_id" ref="real_estate_ads.model_estate_property_offer"/>
            <field name="code">
                action = records.extend_offer_deadline()
            </field>
        </record>

        <!-- cron (Scheduled Action) -->
        <record id="ir_cron_extend_offer_deadline" model="ir.cron">
            <field name="name">Offers: Extend Deadline Daily</field>
            <field name="model_id" ref="model_estate_property_offer"/>
            <field name="state">code</field>
            <field name="code">model._cron_extend_deadline()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!-- Tree (List) View for Property -->
        <record id="estate_property_offer_tree_view" model="ir.ui.view">
            <field name="name">estate.property.offer.tree</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
                    <field name="price"/>
                    <field name="status"/>
                    <field name="partner_id"/>
                    <field name="property_id"/>
                    <field name="creation_date"/>
                    <field name="validity"/>
                    <field name="deadline"/>
                </list>
            </field>
        </record>

        <!-- Form View for Property -->
        <record id="estate_property_offer_form_view" model="ir.ui.view">
            <field name="name">estate.property.offer.form</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="price"/>
                            <field name="status"/>
                            <field name="partner_id"/>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="creation_date"/>
                            <field name="validity"/>
                            <field name="deadline"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>